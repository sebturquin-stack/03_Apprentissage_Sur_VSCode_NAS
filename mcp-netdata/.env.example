# Netdata MCP environment template
# Copy this file to .env before running docker compose.

# Base URL of the Netdata Agent to query from the MCP service.
# Default value targets the Netdata service in docker-compose.
NETDATA_BASE_URL="http://netdata:19999"

# Request timeout used by the MCP service when calling Netdata (milliseconds).
# Increase this value if your Netdata endpoint is slow or remote.
NETDATA_TIMEOUT_MS=5000
